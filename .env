# Exchange Configuration
EXCHANGE=binance
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here
SANDBOX=true

# Trading Parameters
SYMBOL=BTC/USDT
BASE_CURRENCY=USDT
INITIAL_BALANCE=1000

# Risk Management
MAX_POSITION_SIZE=0.1
STOP_LOSS=0.02
TAKE_PROFIT=0.05

# Database
DATABASE_URL=sqlite:///trading_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log