# Hyperliquid Configuration Example
# Copy this file to .env in the root directory and fill in your values

# Hyperliquid Account Settings
ACCOUNT_ADDRESS=0x1234567890123456789012345678901234567890  # Your wallet address
SECRET_KEY=your_private_key_here  # Your wallet private key (keep this secure!)
SANDBOX=True  # Use testnet (True) or mainnet (False)

# Trading Parameters
SYMBOL=BTC/USDC  # Trading pair
BASE_CURRENCY=USDC
INITIAL_BALANCE=1000

# Risk Management
MAX_POSITION_SIZE=0.1  # Maximum position size as fraction of balance
STOP_LOSS=0.02  # 2% stop loss
TAKE_PROFIT=0.05  # 5% take profit

# Database
DATABASE_URL=sqlite:///trading_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
